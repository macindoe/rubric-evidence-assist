# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# From IAM > Users > mum-bedrock-marking-assistant > Security credentials
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Sydney - the AU-scoped inference profile's source region. See AGENTS.md for why
# this must stay within Australia (routes only to Sydney/Melbourne, never overseas).
AWS_DEFAULT_REGION=ap-southeast-2

# Must be an AU-scoped Bedrock inference profile ID (format: au.anthropic.<model-slug>),
# not a bare foundation model ID - see AGENTS.md "The Bedrock model saga" for why, and
# for the current value. Get it from the model's card in the Bedrock console, and make
# sure the IAM policy attached to this user grants InvokeModel on that same profile.
BEDROCK_MODEL_ID=REPLACE_ME

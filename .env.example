# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# From IAM > Users > mum-bedrock-marking-assistant > Security credentials
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Locked decision: Sydney only, no cross-region inference
AWS_DEFAULT_REGION=ap-southeast-2

# Exact model ID/ARN the IAM policy (BedrockClaude35SonnetV2InvokeOnly) grants
# InvokeModel on - copy it from that policy's Resource field or the Bedrock
# console model details page for Claude 3.5 Sonnet v2 in ap-southeast-2.
BEDROCK_MODEL_ID=REPLACE_ME
